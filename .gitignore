# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Build and packaged output
build/
dist/
*.spec.bak

# Backup and temporary files
.backup-*/
*.bak
*.tmp

# Local runtime state
*.log
signature_db.local.json

# PortableAV runtime / output（工作目录、隔离区、报告均为运行产物）
portableav/_work/
portableav_rules_local/
# 绿包构建产物（体积大、可由 tools/build_portable.py 重建）
dist_portable/
.workbuddy/build_portable/

# research/ 下的时点快照：跑快照内的测试会生成同名运行产物（_work、构建缓存），
# 这些是运行副产物，不该进版本库。
research/**/_work/
research/**/.workbuddy/
research/**/__pycache__/

# Editor and OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Keep plugin templates tracked
!plugins/**/*.py.template

# 测试台运行数据（不入库）
testbed/results/

# pytest 临时目录兜底
fk_*/

# 验收过程临时输出（非交付物，避免旧快照造成文档漂移）
acc_*.txt
